//this model only ecept 1 promotion for 1 invoice at a time
//if you want to add more promotion for 1 invoice, another model like "promotionOfInvoice" should be created
//to store the promotionID and invoiceID, many to many relationship
model Invoice {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceDate             DateTime @default(now())
  totalCost               Float
  finalTotalCost          Float
  orderNote               String?
  totalPromotion          Int?
  invoiceStatus           Boolean  @default(false) //true = paid, false = not paid
  employeeID              String   @db.ObjectId
  tableID                 String   @db.ObjectId
  promotionAfterInvoiceID String?  @db.ObjectId
  pointEarned             Int?
  pointUsed               Int?

  //CHEATING
  discount      Float?
  promotionName String?

  //those 2 statuses are not needed
  // createAt                DateTime @default(now())
  // updateAt                DateTime @updatedAt

  PromotionAfterInvoice PromotionAfterInvoice? @relation(fields: [promotionAfterInvoiceID], references: [id])
  Employee              Employee               @relation(fields: [employeeID], references: [id])
  Table                 Table                  @relation(fields: [tableID], references: [id])
  invoiceDetail_list    invoiceDetail[]
  Payment               Payment[]
  PromotionToInvoice    PromotionToInvoice[]
}

model invoiceDetail {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  invoiceID   String @db.ObjectId
  dishID      String @db.ObjectId
  quantity    Int
  totalCost   Int
  salePerUnit Int?

  //CHEATING
  //I know those 2 fields below violate the database rule (and also the CDM), but if i dont add this line, the logic for calculate invoice will be extremely difficult, and i MEAN it!!! DO NOT do it, you will waste your time
  promotionAfterDishID String?  @db.ObjectId
  discount             Float?
  originalPrice        Float
  promotionName        String?
  createAt             DateTime @default(now())

  //Please note that the promotionAfterDishID is not required, it's optional
  //Also please note that this promotion link isn't in the class diagram
  //But the promotion link is needed to know which promotion is used for this dish
  //And it's extreamlly difficult to extract data from which promotion is used for this dish without this link
  //It's in CDM now, but kinda feels unsettling
  Promotion PromotionAfterDish? @relation(fields: [promotionAfterDishID], references: [id])
  Invoice   Invoice             @relation(fields: [invoiceID], references: [id])
  Dish      Dish                @relation(fields: [dishID], references: [id])
}

model Payment {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentDate        DateTime
  totalMoneyReceived Float
  totalMoneyReturn   Float
  totalMoney         Float
  invoiceID          String   @db.ObjectId
  updateAt           DateTime @updatedAt
  createAt           DateTime @default(now())

  Invoice Invoice @relation(fields: [invoiceID], references: [id])
}

//This space is for payment by cash and card

//ingredient stuff
model ingredient {
  id                  String                @id @default(auto()) @map("_id") @db.ObjectId
  ingredientName      String
  isDeleted           Boolean               @default(false)
  ingredientTypeID    String                @db.ObjectId
  importInvoiceDetail importInvoiceDetail[]
  ingredientType      ingredientType        @relation(fields: [ingredientTypeID], references: [id])
  updateAt            DateTime              @updatedAt
  createAt            DateTime              @default(now())
}

model ingredientType {
  id                        String       @id @default(auto()) @map("_id") @db.ObjectId
  ingredientTypeName        String
  ingredientTypeDescription String?
  isDeleted                 Boolean      @default(false)
  ingredient                ingredient[]
  updateAt                  DateTime     @updatedAt
  createAt                  DateTime     @default(now())
}

model Provider {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  providerName        String
  providerDescription String?
  providerPhoneNumber String?
  providerEmail       String?
  providerAddress     String?
  providerStatus      String? //this should have default status and also give the option to custom status, that's why it's string instead of boolean or int
  isDeleted           Boolean         @default(false)
  importInvoice       importInvoice[]
  updateAt            DateTime        @updatedAt
  createAt            DateTime        @default(now())
}

model importInvoice {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  importDate   DateTime //aka arrival date
  //i honestly don't know should i put these 2 status here or not
  // invoiceStatus   Boolean  @default(true) //true = paid, false = not paid
  // orderStatus    Boolean  @default(true) //true = ordered, false = not ordered
  totalExpense Float
  providerID   String   @db.ObjectId
  employeeID   String   @db.ObjectId
  createAt     DateTime @default(now())

  Provider            Provider              @relation(fields: [providerID], references: [id])
  importInvoiceDetail importInvoiceDetail[]
  Employee            Employee              @relation(fields: [employeeID], references: [id])
}

model importInvoiceDetail {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  importInvoiceID String   @db.ObjectId
  ingredientID    String   @db.ObjectId
  quantity        Int
  price           Float
  totalExpense    Float
  createAt        DateTime @default(now())

  ImportInvoice importInvoice @relation(fields: [importInvoiceID], references: [id])
  ingredient    ingredient    @relation(fields: [ingredientID], references: [id])
}

//client side stuff that i dont know if i would use it or not

model Voucher {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  voucherName        String
  voucherPercentage  Float
  voucherDescription String?
  isDeleted          Boolean  @default(false)
  updateAt           DateTime @updatedAt
  createAt           DateTime @default(now())

  voucherUnit voucherUnit[]
}

model voucherUnit {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  voucherUnitCode     String
  voucherReceivedDate DateTime
  voucherExpiredDate  DateTime
  clientID            String   @db.ObjectId
  voucherID           String   @db.ObjectId
  isDeleted           Boolean  @default(false)
  createAt            DateTime @default(now())

  Client  Client  @relation(fields: [clientID], references: [id])
  Voucher Voucher @relation(fields: [voucherID], references: [id])
}

model gift {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  giftName        String
  giftQuantity    Int
  giftImage       String
  giftDescription String?
  pointToExchange Int
  updateAt        DateTime @updatedAt
  createAt        DateTime @default(now())
  isDeleted       Boolean  @default(false)
}

// communitation stuff

model Feedback {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  Text          String
  feedbackDate  DateTime
  isDeleted     Boolean         @default(false)
  FeedbackReply FeedbackReply[]
  clientID      String          @db.ObjectId
  updateAt      DateTime        @updatedAt
  createAt      DateTime        @default(now())

  Client Client @relation(fields: [clientID], references: [id])
}

model FeedbackReply {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  feedbackID String   @db.ObjectId
  replyText  String
  replyDate  DateTime
  isDeleted  Boolean  @default(false)
  emlpoyeeID String   @db.ObjectId
  updateAt   DateTime @updatedAt
  createAt   DateTime @default(now())

  Feedback Feedback @relation(fields: [feedbackID], references: [id])
  Employee Employee @relation(fields: [emlpoyeeID], references: [id])
}

model comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  commentText String
  commentTime DateTime
  isDeleted   Boolean  @default(false)
  dishID      String   @db.ObjectId
  clientID    String   @db.ObjectId
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())

  Client       Client         @relation(fields: [clientID], references: [id])
  Dish         Dish           @relation(fields: [dishID], references: [id])
  commentReply commentReply[]
}

model commentReply {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  replyText String
  replyTime DateTime
  isDeleted Boolean  @default(false)
  clientID  String   @db.ObjectId
  commentID String   @db.ObjectId
  updateAt  DateTime @updatedAt
  createAt  DateTime @default(now())

  comment comment @relation(fields: [commentID], references: [id])
  Client  Client  @relation(fields: [clientID], references: [id])
}

model Rating {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  ratingStar Int
  isDeleted  Boolean  @default(false)
  dishID     String   @db.ObjectId
  clientID   String   @db.ObjectId
  updateAt   DateTime @updatedAt
  createAt   DateTime @default(now())

  Client Client @relation(fields: [clientID], references: [id])
  Dish   Dish   @relation(fields: [dishID], references: [id])
}

model Expense {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseName        String
  expenseDescription String?
  expenseMoney       Float
  createAt           DateTime @default(now())
  updateAt           DateTime @updatedAt
  isDeleted          Boolean  @default(false)
}

model ClientTemporary {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  point       Int      @default(0)
  name        String
  phoneNumber String
  createAt    DateTime @default(now())
  updateAt    DateTime @updatedAt
  // isDeleted   Boolean  @default(false) (THis probably don't need this, i plan to delete this after the user have an actual account)
}

model Room {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  roomKey    String
  clientId   String    @db.ObjectId
  employeeId String    @db.ObjectId
  messages   Message[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   Client   @relation(fields: [clientId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
}

model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  text           String
  senderId       String    @db.ObjectId
  roomId         String    @db.ObjectId
  senderType     Boolean
  clientSender   Client?   @relation(fields: [senderId], references: [id])
  employeeSender Employee? @relation(fields: [senderId], references: [id])
  room           Room      @relation(fields: [roomId], references: [id])
  createdAt      DateTime  @default(now())
}
