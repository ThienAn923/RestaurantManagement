datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Dish {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  available   Boolean  @default(true)
  dishType    String   @db.ObjectId
  isDeleted   Boolean  @default(false)
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())
  promotionID String?  @db.ObjectId
  timeToCook  Int?     @default(10) //Warning!!! this is in minutes, AND, More importantly, it's optional, which is not supposed to be!!! 

  costs        Cost[]
  orderDetails OrderDetail[]

  DishType      DishType            @relation(fields: [dishType], references: [id])
  promotion     PromotionAfterDish? @relation(fields: [promotionID], references: [id])
  invoiceDetail invoiceDetail[]
  images        Image[]
  comment       comment[]
  Rating        Rating[]
}

model Image {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  Link     String
  dishId   String   @db.ObjectId
  updateAt DateTime @updatedAt
  createAt DateTime @default(now())

  Dish Dish @relation(fields: [dishId], references: [id])
}

model Cost {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  dishId   String   @db.ObjectId
  cost     Int
  createAt DateTime @default(now())

  dish Dish @relation(fields: [dishId], references: [id])
}

model DishType {
  id                  String @id @default(auto()) @map("_id") @db.ObjectId
  DishTypeName        String
  DishTypeDescription String

  //Why? prisma don't support sort = boolean, so i use string instead
  DishTypeAvailable Boolean @default(true)

  isDeleted Boolean  @default(false)
  updateAt  DateTime @updatedAt
  createAt  DateTime @default(now())

  dish_list Dish[]
}

model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // orderStatus Boolean  @default(true)
  orderStatus String   @default("new") //new, cooking, finished
  employeeID  String   @db.ObjectId
  orderNote   String?
  tableID     String?  @db.ObjectId //it was originally have @unique but was requested to change by "The higher authority(my teacher)" :<. Sad fr fr (basicly 1-1 to 1-many relationship)
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())

  //new
  forDate DateTime @default(now()) // only get day month year, order time is not needed, the order is for what day

  Employee    Employee      @relation(fields: [employeeID], references: [id])
  Table       Table?        @relation(fields: [tableID], references: [id])
  OrderDetail OrderDetail[]
}

model OrderDetail {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  dishId            String   @db.ObjectId
  quantity          Int
  orderID           String   @db.ObjectId
  updateAt          DateTime @updatedAt
  createAt          DateTime @default(now())
  orderDetailStatus String   @default("new") //new, cooking, finished

  Dish  Dish  @relation(fields: [dishId], references: [id])
  Order Order @relation(fields: [orderID], references: [id])
}

model Table {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tableNumber Int      @unique
  tableStatus Boolean  @default(true)
  seatNumber  Int
  isDeleted   Boolean  @default(false)
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())

  Booking Booking[]
  Order   Order[]
  Invoice Invoice[]
}

model Booking {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  timeStart      DateTime
  timeEnd        DateTime
  numberOfPeople Int
  tableID        String   @db.ObjectId
  clientID       String   @db.ObjectId
  updateAt       DateTime @updatedAt
  createAt       DateTime @default(now())

  Client Client @relation(fields: [clientID], references: [id])
  Table  Table  @relation(fields: [tableID], references: [id])
}

model Client {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  point       Int
  personId    String   @db.ObjectId
  email       String?  @unique
  phoneNumber String?  @unique
  gender      Boolean? @default(true)
  isDeleted   Boolean  @default(false)
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())

  Booking      Booking[]
  person       Person         @relation(fields: [personId], references: [id])
  Feedback     Feedback[]
  comment      comment[]
  commentReply commentReply[]
  Rating       Rating[]
  // voucherUnit  voucherUnit[]
  Room         Room[]
  Message      Message[]
  voucherUnit  voucherUnit[] //not ussed
}

model Person {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  profilePicture String?
  isDeleted      Boolean  @default(false)
  updateAt       DateTime @updatedAt
  createAt       DateTime @default(now())

  employeeId String?    @db.ObjectId
  clientId   String?    @db.ObjectId
  account    account[]
  Employee   Employee[]
  Client     Client[]
}

model Employee {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeAdress      String
  employeeGender      Boolean  @default(true)
  employeeDateOfBirth DateTime
  employeePhoneNumber String
  employeeEmail       String
  personId            String   @db.ObjectId

  orders    Order[] //currently made 0->many order
  isDeleted Boolean  @default(false)
  updateAt  DateTime @updatedAt
  createAt  DateTime @default(now())

  Work          Work[]
  FeedbackReply FeedbackReply[]
  importInvoice importInvoice[]
  Invoice       Invoice[]
  person        Person          @relation(fields: [personId], references: [id])
  Department    Department[]
  Room          Room[]
  Message       Message[]
}

model account {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  accountUsername  String
  accountPassword  String
  AccountAuthority Int
  AccountAvatar    String?
  personId         String   @db.ObjectId
  isDeleted        Boolean  @default(false)
  updateAt         DateTime @updatedAt
  createAt         DateTime @default(now())

  //Why is those important field is "?"
  //Because employee account do not need those
  //Client's account is more complicated than employee account 
  isVerified        Boolean?  @default(false)
  verificationToken String?
  tokenExpiresAt    DateTime?
  Person            Person    @relation(fields: [personId], references: [id])
}

//new
model Department {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  departmentName        String
  departmentDescription String?
  totalEmployee         Int
  headOfDepartment      String?   @db.ObjectId
  isDeleted             Boolean   @default(false)
  Work                  Work[]
  updateAt              DateTime? @updatedAt
  createAt              DateTime? @default(now())

  Employee Employee? @relation(fields: [headOfDepartment], references: [id])
}

model Position {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  positionName        String
  positionDescription String?
  totalEmployee       Int
  isDeleted           Boolean  @default(false)
  Work                Work[]
  updateAt            DateTime @updatedAt
  createAt            DateTime @default(now())
}

model Work {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  startDay     DateTime
  endDate      DateTime?
  isDeleted    Boolean   @default(false)
  employeeID   String    @db.ObjectId
  departmentID String    @db.ObjectId
  positionID   String    @db.ObjectId
  updateAt     DateTime  @updatedAt
  createAt     DateTime  @default(now())

  Employee   Employee   @relation(fields: [employeeID], references: [id])
  Department Department @relation(fields: [departmentID], references: [id])
  Position   Position   @relation(fields: [positionID], references: [id])
}

model Promotion {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  promotionName        String
  promotionDescription String?
  discount             Float
  startDate            DateTime
  endDate              DateTime
  isDeleted            Boolean  @default(false)
  updateAt             DateTime @updatedAt
  createAt             DateTime @default(now())

  PromotionAfterDish    PromotionAfterDish[]
  PromotionAfterInvoice PromotionAfterInvoice[]
  PromotionToInvoice    PromotionToInvoice[]
}

model PromotionAfterDish {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  promotionID String   @db.ObjectId // pointed to it's daddy ;3 (inheritate)
  isDeleted   Boolean  @default(false)
  updateAt    DateTime @updatedAt
  createAt    DateTime @default(now())

  Promotion     Promotion       @relation(fields: [promotionID], references: [id])
  dishes        Dish[]
  invoiceDetail invoiceDetail[]
}

model PromotionAfterInvoice {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  promotionID    String   @db.ObjectId
  minimumSpend   Int?     @default(0)
  promotionLimit Int? //this should be the limit of promotion, if it's null, then it's unlimited for ex: 99k, 199k, 299k
  isDeleted      Boolean  @default(false)
  updateAt       DateTime @updatedAt
  createAt       DateTime @default(now())

  Promotion          Promotion            @relation(fields: [promotionID], references: [id])
  Invoice            Invoice[]
  PromotionToInvoice PromotionToInvoice[]
}

model PromotionToInvoice {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  promotionAfterInvoiceID String   @db.ObjectId
  invoiceID               String   @db.ObjectId
  createAt                DateTime @default(now())

  PromotionAfterInvoice PromotionAfterInvoice @relation(fields: [promotionAfterInvoiceID], references: [id])
  Invoice               Invoice               @relation(fields: [invoiceID], references: [id])
  Promotion             Promotion?            @relation(fields: [promotionId], references: [id])
  promotionId           String?               @db.ObjectId
}

